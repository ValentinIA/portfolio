# Plantilla de secretos. Copia este archivo como .streamlit/secrets.toml
# (ignorado por Git) y rellena los valores. En Streamlit Cloud, pega el mismo
# contenido en: App > Settings > Secrets.

[contacto]
servidor = "smtp.gmail.com"
puerto = 465
usuario = "tu-cuenta@gmail.com"
# Contraseña de aplicación de Google (16 caracteres), NO tu contraseña normal.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
contrasena = "xxxx xxxx xxxx xxxx"
# Opcional: dónde recibir los mensajes. Si se omite, se usa `usuario`.
destinatario = "tu-cuenta@gmail.com"
